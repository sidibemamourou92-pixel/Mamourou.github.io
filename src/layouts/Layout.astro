---
import { profil, deploiement } from '../data/site.js';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

// CSS et JS globaux incorporés au build : le site est 100 % autonome.
// On utilise les versions MINIFIÉES (scripts/optimize.mjs → .build/) si présentes,
// sinon les sources (mode dev). Résultat : un seul HTML allégé.
function readAsset(rel) {
  const min = join(process.cwd(), '.build', rel);
  const src = join(process.cwd(), 'public', rel);
  const p = existsSync(min) ? min : src;
  if (!existsSync(p)) throw new Error(`Asset introuvable : ${p}`);
  return readFileSync(p, 'utf8');
}
const globalCss = readAsset('css/global.css');
const mainJs = readAsset('js/main.js').replace(/^\uFEFF/, '');

const { title: pageTitle, description: pageDescription } = Astro.props;
const nomPrenom = `${profil.prenom} ${profil.nom}`;
const monogram = `${profil.prenom[0]}${profil.nom[0]}`;
const page = {
  title: pageTitle?.fr ?? `${nomPrenom} — ${profil.role.fr}`,
  titleEn: pageTitle?.en ?? `${nomPrenom} — ${profil.role.en}`,
  description: pageDescription?.fr ?? profil.accroche.fr,
  descriptionEn: pageDescription?.en ?? profil.accroche.en,
};
const canonical = deploiement.url.replace(/\/$/, '') + '/';
---

<!doctype html>
<html lang="fr" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title data-i18n data-fr={page.title} data-en={page.titleEn}>{page.title}</title>
    <meta name="description" content={page.description} data-fr-description={page.description} data-en-description={page.descriptionEn} />
    <meta name="author" content={nomPrenom} />
    <meta name="generator" content="Astro — Portfolio 4.0" />
    <meta name="theme-color" content="#0b1220" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={deploiement.ogImage} />
    <meta property="og:locale" content="fr_FR" />
    <meta name="geo.region" content="ML" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={deploiement.ogImage} />

    <!-- JSON-LD : données structurées pour le référencement -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: nomPrenom,
      jobTitle: profil.role.fr,
      url: canonical,
      email: 'mailto:' + profil.email,
      image: deploiement.ogImage,
      sameAs: [
        'https://github.com/sidibemamourou92-pixel',
        'https://www.linkedin.com/in/sidib%C3%A9-mamourou-36848233a',
      ],
      address: { '@type': 'PostalAddress', addressLocality: 'Bamako', addressCountry: 'ML' },
      knowsLanguage: ['fr', 'en'],
    })}></script>

    <!-- CSS global incorporé au build -->
    <style is:inline set:html={globalCss}></style>

    <!-- Détection JS + thème + langue + filet de sécurité anti-page-vide -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          document.documentElement.setAttribute('data-theme', t ? t : 'dark');
          var lang = localStorage.getItem('lang');
          if (lang) document.documentElement.setAttribute('lang', lang);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        setTimeout(function () {
          try {
            var hidden = document.querySelectorAll('.reveal:not(.is-in)');
            if (hidden.length && !document.querySelector('.reveal.is-in')) {
              hidden.forEach(function (el) { el.classList.add('is-in'); });
            }
          } catch (e) {}
        }, 1500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#accueil">Aller au contenu</a>
    <Header monogram={monogram} nomPrenom={nomPrenom} />
    <main id="contenu">
      <slot />
    </main>
    <Footer monogram={monogram} nomPrenom={nomPrenom} />
    <BackToTop />
    <script is:inline set:html={mainJs}></script>
  </body>
</html>