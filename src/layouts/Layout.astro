---
import { profil } from '../data/site.js';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

// CSS et JS globaux incorporés au build : le site est 100 % autonome.
const cssPath = join(process.cwd(), 'public', 'css', 'global.css');
const jsPath = join(process.cwd(), 'public', 'js', 'main.js');
if (!existsSync(cssPath)) throw new Error(`CSS introuvable : ${cssPath}`);
if (!existsSync(jsPath)) throw new Error(`JS introuvable : ${jsPath}`);
const globalCss = readFileSync(cssPath, 'utf8');
const mainJs = readFileSync(jsPath, 'utf8').replace(/^\uFEFF/, '');

const { title: pageTitle, description: pageDescription } = Astro.props;
const page = {
  title: pageTitle ?? `${profil.prenom} ${profil.nom} — ${profil.role}`,
  description: pageDescription ?? profil.accroche,
};
const monogram = `${profil.prenom[0]}${profil.nom[0]}`;
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="author" content={`${profil.prenom} ${profil.nom}`} />
    <meta name="generator" content="Astro — Portfolio 3.0" />
    <meta name="theme-color" content="#f8f9fb" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:locale" content="fr_FR" />

    <style is:inline set:html={globalCss}></style>

    <!-- Détection JS + thème + filet de sécurité anti-page-vide -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        setTimeout(function () {
          try {
            var hidden = document.querySelectorAll('.reveal:not(.is-in)');
            if (hidden.length && !document.querySelector('.reveal.is-in')) {
              hidden.forEach(function (el) { el.classList.add('is-in'); });
            }
          } catch (e) {}
        }, 1500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#accueil">Aller au contenu</a>
    <Header monogram={monogram} />
    <main id="contenu">
      <slot />
    </main>
    <Footer monogram={monogram} />
    <BackToTop />
    <script is:inline set:html={mainJs}></script>
  </body>
</html>