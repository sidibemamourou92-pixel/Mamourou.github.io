---
import { site } from '../data/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

// Feuille de style globale INCORPORÉE au build (source unique : public/css/global.css).
// Plus aucune requête CSS externe → le style s'applique partout, toujours.
const globalCssPath = join(process.cwd(), 'public', 'css', 'global.css');
if (!existsSync(globalCssPath)) throw new Error(`global.css introuvable : ${globalCssPath}`);
const globalCss = readFileSync(globalCssPath, 'utf8');

// Interactions GLOBALES incorporées au build (source unique : public/js/main.js).
// Le BOM initial est retiré. Aucun chargement JS externe → tout fonctionne partout.
const mainJsPath = join(process.cwd(), 'public', 'js', 'main.js');
if (!existsSync(mainJsPath)) throw new Error(`main.js introuvable : ${mainJsPath}`);
const mainJs = readFileSync(mainJsPath, 'utf8').replace(/^\uFEFF/, '');

const { title = `${site.auteur} — ${site.role}`, description = site.description } =
  Astro.props;
const pageUrl = site.url;
const ogImage = new URL('./image/WIN_20260511_10_10_30_Pro.jpg', pageUrl).href;
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.auteur} />
    <meta name="robots" content="index,follow" />
    <meta name="generator" content="Astro — Portfolio évolutif" />
    <meta name="theme-color" content="#0b0e1a" />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.auteur} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.auteur,
      jobTitle: site.role,
      description: site.description,
      url: site.url,
      sameAs: [
        'https://github.com/sidibemamourou92-pixel',
        'https://www.linkedin.com/in/sidib%C3%A9-mamourou-36848233a',
      ],
    })}></script>

    <!-- CSS global incorporé au build (source : public/css/global.css) — aucun chargement externe -->
    <style is:inline set:html={globalCss}></style>

    <!-- Sécurité / thème avant peinture + détection JS -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
        // Filet de sécurité : si le contenu reste masqué par la révélation au scroll
        // (JS externes bloqués, IntersectionObserver défaillant…), on force l'affichage.
        setTimeout(function () {
          try {
            var hidden = document.querySelectorAll('.reveal:not(.is-in)');
            if (hidden.length && !document.querySelector('.reveal.is-in')) {
              hidden.forEach(function (el) { el.classList.add('is-in'); });
            }
          } catch (e) {}
        }, 1500);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#accueil">Aller au contenu</a>
    <Header />
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <!-- JS incorporé au build (source : public/js/main.js) — aucun chargement externe -->
    <script is:inline set:html={mainJs}></script>
  </body>
</html>