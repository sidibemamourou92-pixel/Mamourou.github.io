---
import { profil, stats, asset, sectionVisible, photoAccueil } from '../data/site.js';
import Icon from './Icon.astro';
const specFr = profil.specialites.map(s => s.fr).join(' · ');
const specEn = profil.specialites.map(s => s.en).join(' · ');
const nomPrenom = `${profil.prenom} ${profil.nom}`;
---

<section class="hero" id="accueil">
  <div class="container hero-grid" class:list={{ 'sans-photo': !photoAccueil }}>
    <div class="hero-text">
      <p class="hero-meta">
        <span data-i18n data-fr={profil.localisation.fr} data-en={profil.localisation.en}>{profil.localisation.fr}</span>
        {profil.disponible && (
          <span class="dispo">
            <span class="dispo-dot" aria-hidden="true"></span>
            <span data-i18n data-fr={profil.dispoTexte.fr} data-en={profil.dispoTexte.en}>{profil.dispoTexte.fr}</span>
          </span>
        )}
      </p>

      <h1 class="hero-name">
        <span>{profil.prenom}</span>
        <span>{profil.nom}</span>
      </h1>

      <p class="hero-role">
        <strong data-i18n data-fr={profil.role.fr} data-en={profil.role.en}>{profil.role.fr}</strong>
        <span data-i18n data-fr={specFr} data-en={specEn}>{specFr}</span>
      </p>

      <p class="hero-lead" data-i18n data-fr={profil.accroche.fr} data-en={profil.accroche.en}>{profil.accroche.fr}</p>

      <div class="hero-actions">
        {sectionVisible('projets') && (
          <a href="#projets" class="btn btn-primary">
            <span data-i18n data-fr="Voir mes projets" data-en="See my work">Voir mes projets</span>
            <Icon name="arrowRight" size={16} />
          </a>
        )}
        {sectionVisible('contact') && <a href="#contact" class="btn btn-ghost" data-i18n data-fr="Me contacter" data-en="Get in touch">Me contacter</a>}
      </div>

      {stats.length > 0 && (
        <dl class="hero-stats">
          {stats.map(({ valeur, suffixe, label }) => (
            <div>
              <dt data-i18n data-fr={label.fr} data-en={label.en}>{label.fr}</dt>
              <dd>{valeur}{suffixe}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    {photoAccueil && profil.photo && (
      <figure class="hero-photo">
        <img src={asset(profil.photo)} alt={`Portrait de ${nomPrenom}`} width="440" height="550" fetchpriority="high" />
        <figcaption>
          <span>{nomPrenom}</span>
          <span data-i18n data-fr={profil.role.fr} data-en={profil.role.en}>{profil.role.fr}</span>
        </figcaption>
      </figure>
    )}
  </div>
</section>
