---
import { profil, roles, stats } from '../data/site.js';
import Icon from './Icon.astro';
const rolesJson = JSON.stringify(roles);
---

<section class="hero container" id="accueil">
  <div class="hero-inner">
    <p class="eyebrow">
      <Icon name="terminal" size={14} />
      {profil.localisation} {profil.dispo ? '· ouvert aux nouvelles missions' : ''}
    </p>

    <h1 class="hero-name">{profil.prenom} {profil.nom}</h1>

    <p class="hero-role">
      <span data-type-roles={rolesJson}></span>
      <span class="type-cursor" aria-hidden="true"></span>
    </p>

    <p class="hero-tagline">{profil.accroche}</p>

    <div class="hero-actions">
      <a href="#projets" class="btn btn-primary btn-lg">Voir mes projets</a>
      <a href="#contact" class="btn btn-ghost btn-lg">Me contacter</a>
    </div>

    <div class="hero-stats">
      {stats.map(({ icone, valeur, suffixe, label }) => (
        <div class="stat">
          <strong>{valeur}{suffixe}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>