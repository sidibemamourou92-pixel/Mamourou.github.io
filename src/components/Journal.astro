---
import { chronique } from '../data/site.js';
import Icon from './Icon.astro';

// Tri décroissant par date : le journal évolue automatiquement dans le temps.
const tri = [...chronique].sort((a, b) => b.date.localeCompare(a.date));
const tags = { site: 'Site', projet: 'Projet', veille: 'Veille', formation: 'Formation', outil: 'Outil' };
---

<section class="journal section" id="chronique">
  <div class="section-head reveal">
    <p class="section-eyebrow"><Icon name="doc" size={14} /> $ tail -f journal.md</p>
    <h2 class="section-title">Chronique d’activité</h2>
    <p class="section-subtitle">
      Un journal qui évolue avec mes projets : ajoutez une entrée dans
      <code>src/data/site.js</code> et le site se met à jour.
    </p>
  </div>

  <ol class="journal-list reveal">
    {tri.map(entry => (
      <li class="journal-item" data-type={entry.type}>
        <time class="journal-date" datetime={entry.date}>{entry.date}</time>
        <div class="journal-body">
          <span class="journal-tag">{tags[entry.type] ?? entry.type}</span>
          <strong class="journal-title">{entry.titre}</strong>
          <p>{entry.texte}</p>
        </div>
      </li>
    ))}
  </ol>
</section>