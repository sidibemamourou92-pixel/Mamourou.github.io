---
import { navigation, profil } from '../data/site.js';
import Icon from './Icon.astro';
const { monogram } = Astro.props;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="#accueil" class="brand" aria-label={`Retour à l’accueil — ${profil.prenom} ${profil.nom}`}>
      <span class="brand-mark">{monogram}</span>
      <span>{profil.prenom} {profil.nom}</span>
    </a>

    <nav class="main-nav" aria-label="Navigation principale" data-nav>
      {navigation.map(({ href, label }) => (
        <a href={href} data-spy={href.slice(1)}>{label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" data-theme-toggle aria-label="Changer de thème" title="Changer de thème">
        <span class="ico-sun"><Icon name="sun" size={20} /></span>
        <span class="ico-moon"><Icon name="moon" size={20} /></span>
      </button>
      <button class="nav-burger" data-nav-toggle aria-label="Ouvrir le menu" aria-expanded="false">
        <span class="ico-open"><Icon name="menu" size={22} /></span>
        <span class="ico-close"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>
</header>