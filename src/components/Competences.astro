---
import { competences, numeroSection } from '../data/site.js';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
---

<section class="section" id="competences">
  <div class="container">
    <SectionHead
      num={numeroSection('competences')}
      label={{ fr: 'Compétences', en: 'Skills' }}
      titre={{ fr: 'Ce que je maîtrise', en: 'What I work with' }}
    />

    <ul class="skills">
      {competences.map(g => (
        <li class="skill reveal">
          <div class="skill-head">
            <span class="skill-ico"><Icon name={g.icone} size={20} /></span>
            <div>
              <h3 data-i18n data-fr={g.domaine.fr} data-en={g.domaine.en}>{g.domaine.fr}</h3>
              <p class="skill-level" data-i18n data-fr={g.niveau.fr} data-en={g.niveau.en}>{g.niveau.fr}</p>
            </div>
          </div>
          <ul class="tag-list">
            {g.tags.map(t => <li>{t}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
