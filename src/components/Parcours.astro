---
import { parcours } from '../data/site.js';
import Icon from './Icon.astro';
---

<section class="section container" id="parcours">
  <div class="section-head reveal">
    <p class="section-eyebrow">Parcours</p>
    <h2 class="section-title">Formation & expérience</h2>
  </div>

  <div class="timeline">
    {parcours.map(item => (
      <article class="timeline-item reveal">
        <span class="timeline-marker" aria-hidden="true"></span>
        <div class="timeline-head">
          <span class="timeline-period">{item.periode}</span>
          <span class="timeline-type">{item.type}</span>
        </div>
        <h3>{item.titre}</h3>
        <p class="timeline-lieu"><Icon name="pin" size={13} /> {item.lieu}</p>
        <p class="timeline-detail">{item.detail}</p>
      </article>
    ))}
  </div>
</section>