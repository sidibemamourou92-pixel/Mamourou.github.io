---
import { parcours } from '../data/site.js';
import Icon from './Icon.astro';
---

<section class="section container" id="parcours">
  <div class="section-head reveal">
    <p class="section-eyebrow" data-i18n data-fr="Parcours" data-en="Background">Parcours</p>
    <h2 class="section-title" data-i18n data-fr="Formation & expérience" data-en="Education & experience">Formation & expérience</h2>
  </div>

  <div class="timeline">
    {parcours.map(item => (
      <article class="timeline-item reveal">
        <span class="timeline-marker" aria-hidden="true"></span>
        <div class="timeline-head">
          <span class="timeline-period">{item.periode}</span>
          <span class="timeline-type" data-i18n data-fr={item.type.fr} data-en={item.type.en}>{item.type.fr}</span>
        </div>
        <h3 data-i18n data-fr={item.titre.fr} data-en={item.titre.en}>{item.titre.fr}</h3>
        <p class="timeline-lieu">
          <Icon name="pin" size={13} />
          <span data-i18n data-fr={item.lieu.fr} data-en={item.lieu.en}>{item.lieu.fr}</span>
        </p>
        <p class="timeline-detail" data-i18n data-fr={item.detail.fr} data-en={item.detail.en}>{item.detail.fr}</p>
      </article>
    ))}
  </div>
</section>