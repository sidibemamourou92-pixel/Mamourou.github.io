---
import { parcours, typesParcours, numeroSection, asset } from '../data/site.js';
import SectionHead from './SectionHead.astro';
---

<section class="section" id="parcours">
  <div class="container">
    <SectionHead
      num={numeroSection('parcours')}
      label={{ fr: 'Parcours', en: 'Background' }}
      titre={{ fr: 'Formation & expérience', en: 'Education & experience' }}
    />

    <ol class="timeline">
      {parcours.map(item => {
        const type = typesParcours[item.type] ?? typesParcours.formation;
        return (
          <li class="tl-item reveal">
            <p class="tl-period">{item.periode}</p>
            <div class="tl-body">
              <p class="tl-type" data-i18n data-fr={type.fr} data-en={type.en}>{type.fr}</p>
              <h3 data-i18n data-fr={item.titre.fr} data-en={item.titre.en}>{item.titre.fr}</h3>
              <p class="tl-place">
                {item.logo && <img src={asset(item.logo)} alt="" width="28" height="28" loading="lazy" class="logo-clair" />}
                {item.url
                  ? <a href={item.url} target="_blank" rel="noopener noreferrer" data-i18n data-fr={item.lieu.fr} data-en={item.lieu.en}>{item.lieu.fr}</a>
                  : <span data-i18n data-fr={item.lieu.fr} data-en={item.lieu.en}>{item.lieu.fr}</span>}
              </p>
              <p class="tl-detail" data-i18n data-fr={item.detail.fr} data-en={item.detail.en}>{item.detail.fr}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
