---
import { profil, reseaux } from '../data/site.js';
import Icon from './Icon.astro';
---

<section class="section container" id="contact">
  <div class="section-head reveal">
    <p class="section-eyebrow">Contact</p>
    <h2 class="section-title">Travaillons ensemble</h2>
    <p class="section-subtitle">Un projet, une question, une collaboration ? Écrivez-moi.</p>
  </div>

  <div class="contact-grid">
    <div class="contact-infos reveal">
      <p>Je réponds généralement sous 24 h. Choisissez le canal qui vous convient.</p>

      <ul class="contact-list">
        <li class="contact-row">
          <span class="c-ico"><Icon name="mail" size={18} /></span>
          <div>
            <strong>Email</strong>
            <a href={`mailto:${profil.email}`}>{profil.email}</a>
          </div>
        </li>
        <li class="contact-row">
          <span class="c-ico"><Icon name="pin" size={18} /></span>
          <div>
            <strong>Localisation</strong>
            <span>{profil.localisation} — disponible à distance</span>
          </div>
        </li>
      </ul>

      <div class="contact-socials">
        {reseaux.map(r => (
          <a href={r.url} target="_blank" rel="noopener noreferrer" aria-label={r.nom} title={r.nom}>
            <Icon name={r.icone} size={20} />
          </a>
        ))}
      </div>
    </div>

    <form class="contact-form reveal" data-contact-form data-email={profil.email} novalidate>
      <div class="field">
        <label for="cf-nom">Nom</label>
        <input id="cf-nom" name="nom" type="text" placeholder="Votre nom" required minlength="2" />
      </div>
      <div class="field">
        <label for="cf-email">Email</label>
        <input id="cf-email" name="email" type="email" placeholder="vous@exemple.com" required />
      </div>
      <div class="field">
        <label for="cf-sujet">Sujet</label>
        <input id="cf-sujet" name="sujet" type="text" placeholder="Un projet, une question…" />
      </div>
      <div class="field">
        <label for="cf-msg">Message</label>
        <textarea id="cf-msg" name="message" rows="5" placeholder="Décrivez votre besoin…" required minlength="10"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-lg" data-submit-btn>
        <Icon name="mail" size={18} /> Envoyer le message
      </button>
      <p class="form-note" data-form-note role="status" aria-live="polite"></p>
    </form>
  </div>
</section>