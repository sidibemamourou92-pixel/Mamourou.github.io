---
import { profil, reseaux, site, numeroSection } from '../data/site.js';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
const tel = profil.telephone ? profil.telephone.replace(/\D/g, '') : '';
const sociaux = reseaux.filter(r => r.icone !== 'mail');
// Service d'envoi du formulaire (réglable dans l'admin → Paramètres)
const form = site.formulaire ?? { service: 'formsubmit' };
const service = form.service === 'web3forms' && form.cleWeb3forms ? 'web3forms' : form.service === 'mailto' ? 'mailto' : 'formsubmit';
const endpoint = service === 'web3forms'
  ? 'https://api.web3forms.com/submit'
  : service === 'formsubmit' ? `https://formsubmit.co/ajax/${profil.email}` : '';
---

<section class="section" id="contact">
  <div class="container">
    <SectionHead
      num={numeroSection('contact')}
      label={{ fr: 'Contact', en: 'Contact' }}
      titre={{ fr: 'Un projet ? Parlons-en.', en: 'Have a project? Let’s talk.' }}
    />

    <div class="contact-grid">
      <div class="contact-info reveal">
        <p data-i18n data-fr="Je réponds généralement sous 24 h. Écrivez-moi directement ou utilisez le formulaire." data-en="I usually reply within 24 hours. Email me directly or use the form.">Je réponds généralement sous 24 h. Écrivez-moi directement ou utilisez le formulaire.</p>

        {profil.email && (
          <a class="contact-mail" href={`mailto:${profil.email}`}>
            {profil.email}
            <Icon name="arrowRight" size={20} />
          </a>
        )}

        <ul class="contact-list">
          {tel && (
            <li>
              <Icon name="whatsapp" size={16} />
              <a href={`https://wa.me/${tel}`} target="_blank" rel="noopener noreferrer">{profil.telephone}</a>
            </li>
          )}
          <li>
            <Icon name="pin" size={16} />
            <span data-i18n data-fr={`${profil.localisation.fr} — missions à distance possibles`} data-en={`${profil.localisation.en} — remote work welcome`}>{profil.localisation.fr} — missions à distance possibles</span>
          </li>
          {sociaux.map(r => (
            <li>
              <Icon name={r.icone} size={16} />
              <a href={r.url} target="_blank" rel="noopener noreferrer">{r.nom}</a>
            </li>
          ))}
        </ul>
      </div>

      {profil.email && (
        <form class="contact-form reveal" data-contact-form data-email={profil.email} data-service={service} data-endpoint={endpoint} data-key={service === 'web3forms' ? form.cleWeb3forms : undefined} data-site={`${profil.prenom} ${profil.nom}`} novalidate>
          <!-- Piège à robots : invisible pour les humains -->
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="field-row">
            <div class="field">
              <label for="cf-nom" data-i18n data-fr="Nom" data-en="Name">Nom</label>
              <input id="cf-nom" name="nom" type="text" autocomplete="name" required minlength="2" />
            </div>
            <div class="field">
              <label for="cf-email" data-i18n data-fr="Email" data-en="Email">Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <div class="field">
            <label for="cf-sujet" data-i18n data-fr="Sujet" data-en="Subject">Sujet</label>
            <input id="cf-sujet" name="sujet" type="text" />
          </div>
          <div class="field">
            <label for="cf-msg" data-i18n data-fr="Message" data-en="Message">Message</label>
            <textarea id="cf-msg" name="message" rows="5" required minlength="10" placeholder="Décrivez votre besoin…" data-ph-fr="Décrivez votre besoin…" data-ph-en="Describe what you need…"></textarea>
          </div>
          <button type="submit" class="btn btn-primary" data-submit-btn>
            <span data-i18n data-fr="Envoyer" data-en="Send">Envoyer</span>
            <Icon name="arrowRight" size={16} />
          </button>
          <p class="form-note" data-form-note role="status" aria-live="polite"></p>
        </form>
      )}
    </div>
  </div>
</section>
