---
import { skillGroups, projectMap } from '../data/site.js';
import Icon from './Icon.astro';
---

<section class="skills section" id="competences">
  <div class="section-head reveal">
    <p class="section-eyebrow"><Icon name="chip" size={14} /> $ ls -la /competences</p>
    <h2 class="section-title">Compétences techniques</h2>
    <p class="section-subtitle">Recherchez, filtrez par domaine, et explorez les projets associés.</p>
  </div>

  <div class="skills-tools reveal">
    <label class="search-box">
      <Icon name="search" size={18} />
      <input type="search" id="skillSearch" placeholder="Rechercher une compétence, un outil…" autocomplete="off" />
    </label>
    <div class="skill-filters" role="group" aria-label="Filtrer les compétences">
      <button class="chip-filter is-active" data-skill-cat="tous">Tous</button>
      <button class="chip-filter" data-skill-cat="electronique">Électronique</button>
      <button class="chip-filter" data-skill-cat="robotique">Robotique</button>
      <button class="chip-filter" data-skill-cat="dev">Développement</button>
      <button class="chip-filter" data-skill-cat="reseaux">Réseaux</button>
    </div>
  </div>

  <div class="skills-grid">
    {skillGroups.map((g, i) => (
      <article class="skill-card reveal" data-skill-card data-cat={g.id} style={`--i:${i}`}>
        <div class="skill-head">
          <div class="skill-ico"><Icon name={g.icone} size={22} /></div>
          <div>
            <h3>{g.titre}</h3>
            <span class="skill-cat">{g.categorie}</span>
          </div>
          <span class="skill-level-badge">{g.niveau}%</span>
        </div>

        <div
          class="skill-bar"
          role="progressbar"
          aria-label={g.titre}
          aria-valuenow={g.niveau}
          aria-valuemin="0"
          aria-valuemax="100"
        >
          <span class="skill-bar-fill" data-bar={g.niveau}></span>
        </div>

        <ul class="skill-tags">
          {g.tags.map(t => (
            <li>{t}</li>
          ))}
        </ul>

        {g.projets.length > 0 && (
          <div class="skill-projects">
            <p class="sp-label"><Icon name="wrench" size={13} /> Projets associés :</p>
            <ul>
              {g.projets.map(titre => (
                <li data-open-project={projectMap[titre]}>{titre}</li>
              ))}
            </ul>
          </div>
        )}
      </article>
    ))}
  </div>
</section>