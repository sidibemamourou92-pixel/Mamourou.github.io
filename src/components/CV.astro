---
import { profil, cv, asset, numeroSection } from '../data/site.js';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
const tel = profil.telephone ? profil.telephone.replace(/\D/g, '') : '';
---

<section class="section" id="cv">
  <div class="container">
    <SectionHead
      num={numeroSection('cv')}
      label={{ fr: 'CV', en: 'Resume' }}
      titre={{ fr: 'En bref', en: 'At a glance' }}
    />

    <div class="cv-grid">
      <div class="cv-summary reveal">
        <p class="lead" data-i18n data-fr={cv.resume.fr} data-en={cv.resume.en}>{cv.resume.fr}</p>
        {cv.fichierPdf && (
          <a href={asset(cv.fichierPdf)} class="btn btn-primary" download>
            <Icon name="doc" size={16} />
            <span data-i18n data-fr="Télécharger le CV (PDF)" data-en="Download resume (PDF)">Télécharger le CV (PDF)</span>
          </a>
        )}
      </div>

      <dl class="spec reveal">
        <div>
          <dt data-i18n data-fr="Poste" data-en="Role">Poste</dt>
          <dd data-i18n data-fr={profil.role.fr} data-en={profil.role.en}>{profil.role.fr}</dd>
        </div>
        <div>
          <dt data-i18n data-fr="Domaine" data-en="Field">Domaine</dt>
          <dd data-i18n data-fr={profil.domaine.fr} data-en={profil.domaine.en}>{profil.domaine.fr}</dd>
        </div>
        <div>
          <dt data-i18n data-fr="Localisation" data-en="Location">Localisation</dt>
          <dd data-i18n data-fr={profil.localisation.fr} data-en={profil.localisation.en}>{profil.localisation.fr}</dd>
        </div>
        <div>
          <dt data-i18n data-fr="Nationalité" data-en="Nationality">Nationalité</dt>
          <dd data-i18n data-fr={profil.nationalite.fr} data-en={profil.nationalite.en}>{profil.nationalite.fr}</dd>
        </div>
        {profil.email && (
          <div>
            <dt>Email</dt>
            <dd><a href={`mailto:${profil.email}`}>{profil.email}</a></dd>
          </div>
        )}
        {tel && (
          <div>
            <dt data-i18n data-fr="Téléphone" data-en="Phone">Téléphone</dt>
            <dd><a href={`https://wa.me/${tel}`} target="_blank" rel="noopener noreferrer">{profil.telephone}</a></dd>
          </div>
        )}
      </dl>

      <div class="cv-langs reveal">
        <h3 class="side-title" data-i18n data-fr="Langues" data-en="Languages">Langues</h3>
        <ul>
          {cv.langues.map(l => (
            <li>
              <span data-i18n data-fr={l.nom.fr} data-en={l.nom.en}>{l.nom.fr}</span>
              <span class="muted" data-i18n data-fr={l.niveau.fr} data-en={l.niveau.en}>{l.niveau.fr}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
