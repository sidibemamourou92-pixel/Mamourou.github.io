---
import { profil, entreprise } from '../data/site.js';
import Icon from './Icon.astro';
const monogram = `${profil.prenom[0]}${profil.nom[0]}`;
---

<section class="section container" id="apropos">
  <div class="section-head reveal">
    <p class="section-eyebrow" data-i18n data-fr="À propos" data-en="About">À propos</p>
    <h2 class="section-title" data-i18n data-fr="Présentation" data-en="About me">Présentation</h2>
  </div>

  <div class="about-grid">
    <div class="prose reveal">
      {profil.bio.map(p => (
        <p data-i18n data-fr={p.fr} data-en={p.en}>{p.fr}</p>
      ))}
      <ul class="about-points">
        {profil.points.map(pt => (
          <li>
            <Icon name="check" size={16} />
            <span data-i18n data-fr={pt.fr} data-en={pt.en}>{pt.fr}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="about-card reveal">
      <div class="monogram" aria-hidden="true">{monogram}</div>

      <a class="about-work" href={entreprise.url} target="_blank" rel="noopener noreferrer">
        <picture>
          <source type="image/webp" srcset={entreprise.logoWebp} />
          <img src={entreprise.logo} alt={`Logo de ${entreprise.nom}`} width="34" height="34" loading="lazy" />
        </picture>
        <span>
          <small data-i18n data-fr="Développeur chez" data-en="Engineer at">Développeur chez</small>
          <strong>{entreprise.nom}</strong>
        </span>
      </a>

      <div class="specialites">
        {profil.specialites.map(s => (
          <span class="chip" data-i18n data-fr={s.fr} data-en={s.en}>{s.fr}</span>
        ))}
      </div>
    </aside>
  </div>
</section>