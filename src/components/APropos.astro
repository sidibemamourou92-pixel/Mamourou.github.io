---
import { profil, entreprise } from '../data/site.js';
import Icon from './Icon.astro';
const monogram = `${profil.prenom[0]}${profil.nom[0]}`;
---

<section class="section container" id="apropos">
  <div class="section-head reveal">
    <p class="section-eyebrow">À propos</p>
    <h2 class="section-title">Présentation</h2>
  </div>

  <div class="about-grid">
    <div class="prose reveal">
      {profil.bio.map(p => (
        <p>{p}</p>
      ))}
      <ul class="about-points">
        {profil.points.map(pt => (
          <li><Icon name="check" size={16} /> {pt}</li>
        ))}
      </ul>
    </div>

    <aside class="about-card reveal">
      <div class="monogram" aria-hidden="true">{monogram}</div>

      <a class="about-work" href={entreprise.url} target="_blank" rel="noopener noreferrer">
        <img src={entreprise.logo} alt={`Logo de ${entreprise.nom}`} width="34" height="34" loading="lazy" />
        <span>
          <small>Développeur chez</small>
          <strong>{entreprise.nom}</strong>
        </span>
      </a>

      <div class="specialites">
        {profil.specialites.map(s => (
          <span class="chip">{s}</span>
        ))}
      </div>
    </aside>
  </div>
</section>