---
import { projects } from '../data/site.js';
import Icon from './Icon.astro';
const cards = JSON.stringify(
  projects.map(p => ({
    id: p.id,
    title: p.title,
    description: p.description,
    story: p.story,
    image: p.image,
    technologies: p.technologies,
    features: p.features,
    gallery: p.gallery,
  }))
);
---

<div class="modal project-modal" id="projectModal" role="dialog" aria-modal="true" aria-labelledby="pmTitle">
  <div class="modal-backdrop" data-close-modal></div>
  <div class="modal-panel" data-modal-panel>
    <button class="modal-close" data-close-modal aria-label="Fermer">
      <Icon name="x" size={20} />
    </button>

    <div class="pm-carousel" data-carousel>
      <button class="carousel-nav prev" data-carousel-prev aria-label="Image précédente">
        <Icon name="arrowLeft" size={20} />
      </button>
      <div class="carousel-track">
        <img id="pmImage" src="" alt="" />
      </div>
      <button class="carousel-nav next" data-carousel-next aria-label="Image suivante">
        <Icon name="arrowRight" size={20} />
      </button>
      <ol class="carousel-dots" data-carousel-dots></ol>
    </div>

    <div class="pm-body">
      <span class="pm-category-badge" id="pmCategory"></span>
      <h3 id="pmTitle"></h3>
      <p class="pm-desc" id="pmDescription"></p>

      <div class="pm-story">
        <h4><Icon name="terminal" size={14} /> L’histoire du projet</h4>
        <p id="pmStory"></p>
      </div>

      <div class="pm-cols">
        <div class="pm-col">
          <h4><Icon name="chip" size={14} /> Technologies</h4>
          <ul id="pmTechnologies"></ul>
        </div>
        <div class="pm-col">
          <h4><Icon name="sparkle" size={14} /> Fonctionnalités</h4>
          <ul id="pmFeatures"></ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.__PROJECT_DATA__ = cards;
</script>