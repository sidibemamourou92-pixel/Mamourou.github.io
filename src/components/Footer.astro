---
import { profil, horizon, entreprise } from '../data/site.js';
const { monogram } = Astro.props;
const build = new Date(horizon.build).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a href="#accueil" class="brand" aria-label={`Retour à l’accueil — ${profil.prenom} ${profil.nom}`}>
      <span class="brand-mark">{monogram}</span>
      <span>{profil.prenom} {profil.nom}</span>
    </a>

    <div class="footer-company">
      <span class="footer-label">Développeur chez</span>
      <a href={entreprise.url} target="_blank" rel="noopener noreferrer" class="footer-company-link" aria-label={entreprise.nom}>
        <img src={entreprise.logo} alt={`Logo de ${entreprise.nom}`} width="38" height="38" loading="lazy" />
        <span>
          <strong>{entreprise.nom}</strong>
          <small>{entreprise.slogan}</small>
        </span>
      </a>
    </div>

    <div class="footer-meta">
      <p>© <span data-year>{new Date().getFullYear()}</span> {profil.prenom} {profil.nom} — Tous droits réservés.</p>
      <p>Mis à jour le {build}</p>
    </div>
  </div>
</footer>