---
import { entreprise, build, reseaux } from '../data/site.js';
import Icon from './Icon.astro';
const { nomPrenom } = Astro.props;
const date = new Date(build);
const fmt = (loc) => date.toLocaleDateString(loc, { day: 'numeric', month: 'long', year: 'numeric' });
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-id">
      <p class="footer-name">{nomPrenom}</p>
      <p class="muted">
        © <span data-year>{date.getFullYear()}</span> ·
        <span data-i18n data-fr={`Mis à jour le ${fmt('fr-FR')}`} data-en={`Updated ${fmt('en-GB')}`}>Mis à jour le {fmt('fr-FR')}</span>
      </p>
    </div>

    <ul class="footer-social">
      {reseaux.map(r => (
        <li>
          <a href={r.url} target={r.url.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" aria-label={r.nom} title={r.nom}>
            <Icon name={r.icone} size={18} />
          </a>
        </li>
      ))}
    </ul>

    {entreprise.afficher && (
      <p class="footer-company muted">
        <span data-i18n data-fr={entreprise.fonction.fr} data-en={entreprise.fonction.en}>{entreprise.fonction.fr}</span>
        {' '}<a href={entreprise.url} target="_blank" rel="noopener noreferrer">{entreprise.nom}</a>
      </p>
    )}
  </div>
</footer>
