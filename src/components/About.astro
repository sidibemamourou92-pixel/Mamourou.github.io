---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
---

<section class="about section" id="apropos">
  <div class="section-head reveal">
    <p class="section-eyebrow"><Icon name="terminal" size={14} /> $ whoami</p>
    <h2 class="section-title">À propos de moi</h2>
  </div>

  <div class="about-grid">
    <div class="about-text reveal">
      <p>
        Je suis <strong>{site.auteur}</strong>, {site.role.toLowerCase()} et passionné de
        systèmes embarqués. Mon terrain de jeu : transformer une idée en circuit, puis en
        prototype fonctionnel — du composant électronique jusqu’au code applicatif.
      </p>
      <p>
        Spécialisé en <strong>robotique</strong>, <strong>IoT</strong> et
        <strong>intelligence artificielle embarquée</strong>, j’aime résoudre des problèmes
        concrets avec des solutions élégantes, économes en énergie et fiables sur le terrain.
      </p>
      <p>
        Chaque projet est pour moi une expédition : observer, prototyper, tester, itérer —
        jusqu’à ce que la machine réponde exactement comme prévu.
      </p>

      <ul class="about-points">
        <li><Icon name="sparkle" size={18} /> Du circuit au code : projet de A à Z</li>
        <li><Icon name="bolt" size={18} /> Prototype rapide puis industrialisation</li>
        <li><Icon name="heart" size={18} /> Curiosité technique & veille constante</li>
      </ul>
    </div>

    <div class="about-terminal reveal" data-terminal>
      <div class="terminal-bar">
        <span class="tb-dot red"></span>
        <span class="tb-dot yellow"></span>
        <span class="tb-dot green"></span>
        <span class="tb-title">mamourou@embedded:~</span>
      </div>
      <div class="terminal-body">
        <p class="t-line"><span class="t-prompt">$</span> whoami</p>
        <p class="t-out">mamourou — ingénieur informatique & maker</p>
        <p class="t-line"><span class="t-prompt">$</span> cat passions.txt</p>
        <p class="t-out">robotique · iot · ia embarquée · impression 3d</p>
        <p class="t-line"><span class="t-prompt">$</span> cat competences.txt</p>
        <p class="t-out">arduino · esp32 · c/c++ · python · linux · pcb</p>
        <p class="t-line"><span class="t-prompt">$</span> echo $MOTIVATION</p>
        <p class="t-out t-high">100 % — bâtir l’avenir, un bit à la fois</p>
        <p class="t-line">
          <span class="t-prompt">$</span> <span class="t-cursor" aria-hidden="true">▊</span>
        </p>
      </div>
    </div>
  </div>
</section>