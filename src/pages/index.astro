---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import APropos from '../components/APropos.astro';
import CV from '../components/CV.astro';
import Competences from '../components/Competences.astro';
import Projets from '../components/Projets.astro';
import Parcours from '../components/Parcours.astro';
import Contact from '../components/Contact.astro';
import { sectionVisible } from '../data/site.js';
---

<Layout>
  <Hero />
  {sectionVisible('apropos') && <APropos />}
  {sectionVisible('cv') && <CV />}
  {sectionVisible('competences') && <Competences />}
  {sectionVisible('projets') && <Projets />}
  {sectionVisible('parcours') && <Parcours />}
  {sectionVisible('contact') && <Contact />}
</Layout>
