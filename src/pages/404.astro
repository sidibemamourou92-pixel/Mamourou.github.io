---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
---

<Layout title="404 — Signal perdu | Mamourou Sidibé" description="Page introuvable.">
  <section class="notfound">
    <div class="notfound-bg" aria-hidden="true">
      <div class="grid-overlay"></div>
      <div class="blob blob-1"></div>
    </div>
    <div class="notfound-inner">
      <p class="notfound-code">
        <span class="type-cursor" aria-hidden="true"></span><code>// erreur 404</code>
      </p>
      <h1>
        <span>Signal</span>
        <span class="grad-text">perdu</span>
      </h1>
      <p class="notfound-text">
        La page que vous cherchez n’existe pas — ou elle a été révoquée par une instruction
        <code>exit</code> prématurée.
      </p>
      <a href="/" class="btn btn-primary">
        <Icon name="home" size={18} /> Retour à l’accueil
      </a>
    </div>
  </section>
</Layout>