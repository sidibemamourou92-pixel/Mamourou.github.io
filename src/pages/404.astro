---
import Layout from '../layouts/Layout.astro';
import { profil } from '../data/site.js';
---

<Layout
  title={`Page introuvable — ${profil.prenom} ${profil.nom}`}
  description="Page introuvable."
>
  <section class="section container" id="accueil">
    <div class="section-head">
      <p class="section-eyebrow">// erreur 404</p>
      <h1 class="section-title">Page introuvable</h1>
      <p class="section-subtitle">Cette page n’existe pas ou a été déplacée.</p>
    </div>
    <a href="./" class="btn btn-primary">Retour à l’accueil</a>
  </section>
</Layout>